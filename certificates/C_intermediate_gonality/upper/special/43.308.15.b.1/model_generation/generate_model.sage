#!/usr/bin/env sage
"""Generate a certified modular-unit plane model for an intermediate modular curve."""

import argparse
import json
from pathlib import Path


def parse_delta_generators(value):
    """Parse a comma-separated list such as ``42,6``."""
    try:
        generators = [int(entry.strip()) for entry in value.split(",") if entry.strip()]
    except ValueError as error:
        raise argparse.ArgumentTypeError(
            "delta generators must be comma-separated integers"
        ) from error
    if not generators:
        raise argparse.ArgumentTypeError("at least one delta generator is required")
    return generators


parser = argparse.ArgumentParser(
    description=(
        "Generate a certified modular-unit plane model for X_Delta(N) using "
        "the current version-4 construction."
    )
)
parser.add_argument("--label", required=True, help="curve label used in output metadata")
parser.add_argument("--level", required=True, type=int, help="level N")
parser.add_argument(
    "--delta-generators",
    required=True,
    type=parse_delta_generators,
    help="comma-separated generators of Delta, for example 42,6",
)
parser.add_argument(
    "--expected-genus",
    required=True,
    type=int,
    help="expected genus recorded in metadata (not checked by this script)",
)
parser.add_argument(
    "--output-dir",
    required=True,
    type=Path,
    help="directory in which model.m and model_metadata.json are written",
)
arguments = parser.parse_args()

module_dir = Path(__file__).resolve().parent
load(str(module_dir / "modular_units_lib.sage"))
load(str(module_dir / "modular_unit_models_v4.sage"))

result = modular_unit_plane_model(
    arguments.level,
    arguments.delta_generators,
    diagnostics=True,
)
polynomial = result["polynomial"]

output_dir = arguments.output_dir.resolve()
output_dir.mkdir(parents=True, exist_ok=True)

(output_dir / "model.m").write_text(
    f"// Certified modular-unit plane model for {arguments.label}.\n"
    "// Generated by model_generation/generate_model.sage "
    "using modular_unit_models_v4.sage.\n"
    "Pol<X,Y> := PolynomialRing(Rationals(),2);\n"
    f"model := {polynomial};\n"
)

metadata = {
    "label": arguments.label,
    "level": arguments.level,
    "delta_generators": arguments.delta_generators,
    "expected_genus": arguments.expected_genus,
    "model_library_version": MODULAR_UNIT_MODELS_VERSION,
    "birational": bool(result["birational"]),
    "X_degree": int(result["X_degree"]),
    "Y_degree": int(result["Y_degree"]),
    "X_function": str(result["X_function"]),
    "Y_function": str(result["Y_function"]),
    "X_divisor": [int(a) for a in result["X_divisor"]],
    "Y_divisor": [int(a) for a in result["Y_divisor"]],
}
(output_dir / "model_metadata.json").write_text(
    json.dumps(metadata, indent=2, default=int) + "\n"
)

print(f"MODEL_FILE={output_dir / 'model.m'}")
print(f"METADATA_FILE={output_dir / 'model_metadata.json'}")
print(f"BIRATIONAL={result['birational']}")
print(f"DEGREES=({result['X_degree']},{result['Y_degree']})")
