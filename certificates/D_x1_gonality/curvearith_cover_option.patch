diff --git a/tests/src/test_covers.m b/tests/src/test_covers.m
new file mode 100644
index 0000000..b99d036
--- /dev/null
+++ b/tests/src/test_covers.m
@@ -0,0 +1,28 @@
+
+// C3 and C5 are the curves of test_gonality.m. On C3 at d = 2 every cover has
+// a nonconstant function, but none of degree at most 2. C5 has no rational
+// points, so "Cover" uses "LinAlg".
+P<x,y,z> := ProjectiveSpace(GF(3), 2);
+C3 := Curve(P, 4*x^4 - y^4 - z^4);
+P<x,y,z> := ProjectiveSpace(GF(5), 2);
+C5 := Curve(P, 4*x^4 - y^4 - z^4);
+
+// Two plane quintics over F_2, of genus 6. On D3 at d = 3 a cover containing
+// a place of degree 2 has a nonconstant function, but none of degree at most 3.
+// On D1 at d = 4 every cover with a function of degree at most 4 contains a
+// place of degree 2.
+P<x,y,z> := ProjectiveSpace(GF(2), 2);
+D3 := Curve(P, x^5 + x^3*y^2 + y^5 + x^4*z + y^4*z + x*y^2*z^2 + y^3*z^2 + x^2*z^3 + x*y*z^3 + x*z^4);
+D1 := Curve(P, x^5 + x^4*y + x^3*y^2 + y^5 + x^3*y*z + x^2*z^3 + x*y*z^3 + y^2*z^3 + z^5);
+
+procedure TestCoverHasFunctionOfDegreeAtMost()
+    for b in [1, 2] do
+        TSTAssertEQ(CAHasFunctionOfDegreeAtMost(C3, 2 : Al := "Cover", Baseline := b), false);
+        TSTAssertEQ(CAHasFunctionOfDegreeAtMost(C5, 3 : Al := "Cover", Baseline := b), false);
+        TSTAssertEQ(CAHasFunctionOfDegreeAtMost(D3, 3 : Al := "Cover", Baseline := b), false);
+        TSTAssertEQ(CAHasFunctionOfDegreeAtMost(D1, 4 : Al := "Cover", Baseline := b), true);
+    end for;
+end procedure;
+
+
+TestCoverHasFunctionOfDegreeAtMost();
